	"tokenColors": [
		{
			"name": "Plain text: undoes the base theme's colors for these broad scopes",
			"scope": [
				"entity",
				"entity.name",
				"constant",
				"support",
				"meta.block",
				"meta.export.default",
				"meta.definition.variable",
				"meta.object.member",
				"meta.embedded.expression",
				"meta.jsx.children",
				"meta.tag.attributes",
				"meta.module-reference",
				"markup.ignored",
				"markup.untracked"
			],
			"settings": { "foreground": "#1d1d1d", "fontStyle": "" }
		},
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": { "foreground": "#008000", "fontStyle": "italic" }
		},
		{
			"name": "Punctuation and operators",
			"scope": [
				"punctuation",
				"keyword.operator",
				"meta.brace",
				"meta.delimiter",
				"brackethighlighter.tag",
				"brackethighlighter.curly",
				"brackethighlighter.round",
				"brackethighlighter.square",
				"brackethighlighter.angle",
				"brackethighlighter.quote"
			],
			"settings": { "foreground": "#505052", "fontStyle": "" }
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"variable.language",
				"constant.language"
			],
			"settings": { "foreground": "#af00db", "fontStyle": "" }
		},
		{
			"name": "Control keywords",
			"scope": [
				"keyword.control"
			],
			"settings": { "foreground": "#af00db", "fontStyle": "" }
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"punctuation.definition.string",
				"string.regexp",
				"source.regexp",
				"string.regexp.character-class",
				"string.regexp source.ruby.embedded",
				"string.regexp string.regexp.arbitrary-repitition",
				"support.constant",
				"markup.inline.raw",
				"constant.other.reference.link",
				"string.other.link"
			],
			"settings": { "foreground": "#a31515", "fontStyle": "" }
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"keyword.other.unit",
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": { "foreground": "#098658", "fontStyle": "" }
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": { "foreground": "#795e26", "fontStyle": "" }
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"support.class.component",
				"support.constant.math",
				"support.constant.json",
				"constant.language.undefined",
				"new.expr entity.name.function"
			],
			"settings": { "foreground": "#267f99", "fontStyle": "" }
		},
		{
			"name": "Variables, parameters and properties",
			"scope": [
				"variable",
				"variable.other",
				"variable.parameter",
				"variable.parameter.function",
				"variable.other.constant",
				"variable.other.enummember",
				"entity.name.variable",
				"entity.name.constant",
				"meta.object-literal.key",
				"meta.property-name",
				"support.variable",
				"support.type.property-name",
				"support.type.property-name.json",
				"entity.other.attribute-name",
				"constant.other.placeholder",
				"string variable"
			],
			"settings": { "foreground": "#001080", "fontStyle": "" }
		},
		{
			"name": "Tags, escapes and embedded code",
			"scope": [
				"entity.name.tag",
				"constant.character",
				"constant.character.escape",
				"string.regexp constant.character.escape",
				"punctuation.section.embedded",
				"punctuation.definition.template-expression",
				"punctuation.definition.list.begin.markdown",
				"markup.changed",
				"punctuation.definition.changed",
				"meta.diff.header",
				"meta.diff.range",
				"meta.separator",
				"meta.output"
			],
			"settings": { "foreground": "#0000ff", "fontStyle": "" }
		},
		{
			"name": "Headings",
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": { "foreground": "#0000ff", "fontStyle": "bold" }
		},
		{
			"name": "Emphasis",
			"scope": [
				"markup.italic"
			],
			"settings": { "foreground": "#1d1d1d", "fontStyle": "italic" }
		},
		{
			"name": "Strong",
			"scope": [
				"markup.bold"
			],
			"settings": { "foreground": "#1d1d1d", "fontStyle": "bold" }
		},
		{
			"name": "Quotes",
			"scope": [
				"markup.quote"
			],
			"settings": { "foreground": "#008000", "fontStyle": "" }
		},
		{
			"name": "Deleted lines",
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": { "foreground": "#a31515", "fontStyle": "" }
		},
		{
			"name": "Invalid code",
			"scope": [
				"invalid",
				"invalid.broken",
				"invalid.deprecated",
				"invalid.illegal",
				"invalid.unimplemented",
				"message.error"
			],
			"settings": { "foreground": "#c23652", "fontStyle": "" }
		}
	],
	"semanticTokenColors": {
		"variable.defaultLibrary": "#267f99",
